# Supabase project settings (Project Settings -> API).
# Leave both blank to run in offline demo mode against a local demo.db.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-publishable-key

# Force offline demo mode even when the two values above are filled in.
# PHONICS_DEMO=1

# Look and feel. Default is "vivid": high-contrast, colourful, larger type,
# built for a teacher with low vision. Set to "classic" to go back to the
# original quieter blue-grey design. See theme.py.
# PHONICS_THEME=classic
