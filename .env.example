# Supabase project settings (Project Settings -> API).
# Leave both blank to run in offline demo mode against a local demo.db.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-publishable-key

# Force offline demo mode even when the two values above are filled in.
# PHONICS_DEMO=1

# Look and feel. Default is "melon": light pastel fills with dark ink,
# contrast-checked for a teacher with low vision. Alternatives: "vivid"
# (saturated, high contrast) or "classic" (the original). See theme.py.
# PHONICS_THEME=vivid
